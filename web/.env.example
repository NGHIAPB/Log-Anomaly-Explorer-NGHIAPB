# Copy thanh ".env.local" de dev local:
#   cp .env.example .env.local
#
# Dia chi query-api (Nghia) ma frontend nay goi. Rong = mac dinh
# "http://localhost:8002" (xem src/lib/api.ts) - dung khi chay backend local
# qua docker-compose.yml o goc repo.
#
# Khi deploy len Vercel, dat bien nay trong Project Settings > Environment
# Variables thanh URL PUBLIC, HTTPS cua backend that (vd. domain/sslip.io da
# deploy theo docs/task/deployment.md) - Vercel phuc vu trang qua HTTPS nen
# trinh duyet se CHAN (Mixed Content) neu backend chi co HTTP thuan.
VITE_API_BASE_URL=http://localhost:8002
