# Copy thanh ".env.local" de dev local:
#   cp .env.example .env.local
#
# Dia chi query-api (Nghia) ma frontend nay goi. Rong = mac dinh
# "http://localhost:8002" (xem src/lib/api.ts) - dung khi chay backend local
# qua docker-compose.yml o goc repo.
#
# Khi deploy len Vercel, dat bien nay trong Project Settings > Environment
# Variables thanh URL PUBLIC cua backend that (vd. https://log-anomaly.example.com
# neu da deploy qua docs/task/deployment.md) - Vercel KHONG the goi toi
# "localhost" cua may ban.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002
