# Cau hinh cho docker-compose.yml o goc repo (stack deploy day du - Nghia).
# Copy thanh ".env" roi chinh theo moi truong that:
#   cp .env.example .env
#
# Tat ca bien o day co gia tri mac dinh hop ly trong docker-compose.yml -
# KHONG bat buoc phai co file .env de chay `docker compose up -d --build`.

# --- Gateway (Caddy) ---
# Mac dinh ":80" (chi HTTP, dung khi test qua IP may chu, chua co domain).
# Dat thanh domain that (vd. log-anomaly.example.com) de Caddy TU DONG cap
# HTTPS qua Let's Encrypt - nho mo them port 443 va tro DNS domain ve may chu.
PUBLIC_ADDRESS=:80

# --- Retention (ingestion + query-api, xem ingestion/README.md) ---
RETENTION_DAYS=30
RETENTION_INTERVAL_HOURS=24

# --- Clustering / Anomaly score / Alert (Nam, xem clustering/README.md) ---
CLUSTERING_WINDOW_MINUTES=10
CLUSTERING_BASELINE_WINDOWS=6
CLUSTERING_INTERVAL_SECONDS=60
ANOMALY_THRESHOLD=2.0
# Webhook nhan alert khi vuot nguong (vd. Slack incoming webhook). Rong = chi
# cap nhat status="alerted", khong gui di dau (xem clustering/src/alert.py).
ALERT_WEBHOOK_URL=

# --- OpenTelemetry (demo-app, xem demo-app/src/telemetry.py) ---
# Rong = fallback ve ConsoleSpanExporter (xem docker logs log-anomaly-demo-app).
# Dat endpoint OTLP/HTTP that (vd. http://otel-collector:4318) neu co collector.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Synthetic traffic (Nghia, xem deploy/synthetic_traffic.py) ---
# Chu ky "tick" (giay) - moi tick chon ngau nhien 1 trong 5 kieu hanh vi
# (normal/timeout/quarantine/anomaly/alert) de dashboard luon co du lieu song
# ma khong can bam tay. Dat SYNTHETIC_TICK_SECONDS=0 KHONG tat duoc job (van
# chay, chi la tick lien tuc khong nghi) - muon tat han, dung
# `docker compose stop synthetic-traffic`.
SYNTHETIC_TICK_SECONDS=300
